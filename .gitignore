temp/
data/*.mdb
axtrace.txt
test/browser/helpers/*.log
_diag/
data/backup/
images/upload/*
!images/upload/face/
images/upload/face/*
__pycache__/
inc/Templet/*.JS
inc/Templet/*.js
# generated by the admin panel's SiteMap job (manage/BlockUpdate, BlockType=4)
/sitemap.xml
/sitemap_*.xml
# per-category CMS channel configs, created on demand by article/center.asp?action=setchannel
article/inc/cache/home_channellist_[1-9]*.asp

# The application writes into these. Git cannot store an empty directory, so a .gitkeep is
# committed in each and the contents ignored — without them a fresh clone or unzipped release
# cannot accept an upload, write a backup or render a captcha.
!temp/.gitkeep
!images/upload/.gitkeep
!images/upload/face/.gitkeep
!data/backup/.gitkeep
